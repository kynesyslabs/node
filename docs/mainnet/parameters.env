# Mainnet must-match parameters. Every mainnet validator runs exactly these
# values; docs/mainnet/parameters.md says what each one does and what breaks
# when one node differs.
#
# Put every KEY=value line below into the node's .env (INSTALL.md, "Run a
# released image", step 3). `./scripts/node-doctor --production` reads this
# file and fails when the value the node container gets differs from it.
#
# Changing a value here is a network-wide change: every validator applies it
# at the same time, from the same release.

# Block timing (seconds)
CONSENSUS_TIME=10
BLOCK_TIMESTAMP_MIN_DELTA=1
BLOCK_TIMESTAMP_TOLERANCE=60

# Fees, in DEM per transaction component
NETWORK_FEE=1
RPC_FEE=1
BURN_FEE=1
RPC_FEE_PERCENT=10

# Validator stake floor, in OS (1000 DEM)
MIN_VALIDATOR_STAKE=1000000000000

# Points awarded for a verified ZK identity attestation
ZK_ATTESTATION_POINTS=10

# Validator mode
PROD=true
DEMOS_REQUIRE_VALIDATORS=true
FORK_SCHEDULE_MISMATCH_POLICY=abstain

# Genesis pins: filled in when the mainnet genesis is published
# (docs/mainnet/genesis-hash.md). Until then set them in .env from the
# announcement; node-doctor checks their format.
# EXPECTED_GENESIS_HASH=
# EXPECTED_GENESIS_BLOCK_HASH=
