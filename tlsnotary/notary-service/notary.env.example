# Settings of one Demos TLSNotary notary, read by tlsn-notary.service (the
# preflight), docker compose and notary-check.sh. Copy to
# /etc/tlsn-notary/notary.env (root:root 0600) and fill in.

# The compressed public key of the key this host serves, from the key
# ceremony's <id>.notary-key.json; it must be listed in the genesis notaryKeys.
NOTARY_EXPECTED_PUBKEY=FILL: 33-byte compressed secp256k1 public key, lowercase hex

# The decrypted key file (PKCS#8 PEM), owned by NOTARY_UID, mode 0400
NOTARY_KEY_FILE=/etc/tlsn-notary/notary.key
NOTARY_UID=10001
NOTARY_GID=10001

# Published on loopback for a TLS reverse proxy on this host. A proxy on
# another host needs a private address here; every-interface addresses are
# refused by the preflight.
NOTARY_BIND=127.0.0.1
NOTARY_HOST_PORT=7047

# Where the preflight writes its stamp; on tmpfs, so a reboot clears it
NOTARY_STAMP_DIR=/run/tlsn-notary

# Sessions in flight; each needs about 1 GiB of the 3 GiB container cap
NOTARY_CONCURRENCY=2

# Largest NTP offset the preflight and the health check accept, in seconds;
# below the fork's futureSkewSec (60 on mainnet)
NOTARY_MAX_CLOCK_OFFSET_SEC=30
NOTARY_FUTURE_SKEW_SEC=60

# Health check target (the published port)
NOTARY_URL=http://127.0.0.1:7047

# Never set NOTARY_ALLOW_UNSYNCED_CLOCK on a notary whose key a genesis lists
