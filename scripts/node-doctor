#!/bin/bash

# ============================================================================
# Node Doctor - Diagnostic tool for Demos Network nodes
# ============================================================================
#
# Usage: ./node-doctor [OPTIONS]
#
# This script runs a series of health checks on your node setup and provides
# actionable hints when problems are detected.
#
# ============================================================================

# NOTE: We don't use 'set -e' because arithmetic operations like ((x++))
# return exit code 1 when x is 0, which would abort the script

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ============================================================================
# Result Accumulators
# ============================================================================

# Arrays to store results
declare -a OK_MESSAGES=()
declare -a PROBLEM_MESSAGES=()
declare -a WARNING_MESSAGES=()
declare -a HINT_MESSAGES=()

# Counters
CHECKS_RUN=0
CHECKS_PASSED=0
CHECKS_FAILED=0
CHECKS_WARNED=0

# ============================================================================
# Helper Functions
# ============================================================================

# Add an OK result
report_ok() {
	local check_name="$1"
	local message="$2"
	OK_MESSAGES+=("[${check_name}] ${message}")
	CHECKS_PASSED=$((CHECKS_PASSED + 1))
}

# Add a PROBLEM result
report_problem() {
	local check_name="$1"
	local message="$2"
	local hint="${3-}"
	PROBLEM_MESSAGES+=("[${check_name}] ${message}")
	if [[ -n "${hint}" ]]; then
		HINT_MESSAGES+=("[${check_name}] 💡 ${hint}")
	fi
	CHECKS_FAILED=$((CHECKS_FAILED + 1))
}

# Add a WARNING result (not critical but worth noting)
report_warning() {
	local check_name="$1"
	local message="$2"
	local hint="${3-}"
	WARNING_MESSAGES+=("[${check_name}] ${message}")
	if [[ -n "${hint}" ]]; then
		HINT_MESSAGES+=("[${check_name}] 💡 ${hint}")
	fi
	CHECKS_WARNED=$((CHECKS_WARNED + 1))
}

# Run a check (wrapper that increments counter)
run_check() {
	local check_name="$1"
	local check_function="$2"
	CHECKS_RUN=$((CHECKS_RUN + 1))

	echo -ne "  Checking ${check_name}... "

	# Run the check function
	if ${check_function}; then
		echo -e "${GREEN}✓${NC}"
	else
		echo -e "${RED}✗${NC}"
	fi
}

# Print section header
print_section() {
	echo ""
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
	echo -e "${BOLD}  $1${NC}"
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# ============================================================================
# Diagnostic Checks
# ============================================================================
# Each check function should:
#   1. Perform a specific diagnostic
#   2. Call report_ok(), report_problem(), or report_warning()
#   3. Return 0 for pass, 1 for fail (for visual feedback)
# ============================================================================

# --- Example Check: Git Origin ---
check_git_origin() {
	local origin_url=$(git remote get-url origin 2>/dev/null)

	if [[ -z "${origin_url}" ]]; then
		report_problem "Git Origin" "No git origin configured" \
			"Run: git remote add origin https://github.com/kynesyslabs/node"
		return 1
	fi

	local valid_https="https://github.com/kynesyslabs/node"
	local valid_https_git="https://github.com/kynesyslabs/node.git"
	local valid_ssh="git@github.com:kynesyslabs/node.git"

	if [[ "${origin_url}" = "${valid_https}" ]] || [[ "${origin_url}" = "${valid_https_git}" ]] ||
		[[ "${origin_url}" = "${valid_ssh}" ]]; then
		report_ok "Git Origin" "Origin correctly set to official repository"
		return 0
	else
		report_problem "Git Origin" "Origin points to: ${origin_url} (expected official repo)" \
			"Run: git remote set-url origin https://github.com/kynesyslabs/node"
		return 1
	fi
}

# --- Example Check: Git Branch ---
check_git_branch() {
	local current_branch=$(git branch --show-current 2>/dev/null)

	if [[ -z "${current_branch}" ]]; then
		report_warning "Git Branch" "Could not determine current branch" \
			"Make sure you're in a git repository"
		return 1
	fi

	if [[ "${current_branch}" = "testnet" ]] || [[ "${current_branch}" = "main" ]]; then
		report_ok "Git Branch" "On branch: ${current_branch}"
		return 0
	else
		report_warning "Git Branch" "On branch: ${current_branch} (expected testnet or main)" \
			"For production, use: git checkout testnet"
		return 1
	fi
}

# --- Check: Bun Installed (requires >= 1.2) ---
check_bun_installed() {
	if ! command -v bun &>/dev/null; then
		report_problem "Bun Runtime" "Bun is not installed" \
			"Install Bun: curl -fsSL https://bun.sh/install | bash"
		return 1
	fi

	local bun_version=$(bun --version 2>/dev/null)

	# Extract major.minor version
	local major=$(echo "${bun_version}" | cut -d. -f1)
	local minor=$(echo "${bun_version}" | cut -d. -f2)

	# Check if version >= 1.2
	if [[ "${major}" -gt 1 ]] || ([[ "${major}" -eq 1 ]] && [[ "${minor}" -ge 2 ]]); then
		report_ok "Bun Runtime" "Bun ${bun_version} (>= 1.2 required)"
		return 0
	else
		report_problem "Bun Runtime" "Bun ${bun_version} is too old (>= 1.2 required)" \
			"Update Bun: bun upgrade"
		return 1
	fi
}

# --- Check: Docker Running ---
check_docker_running() {
	if ! command -v docker &>/dev/null; then
		report_problem "Docker" "Docker is not installed" \
			"Install Docker: https://docs.docker.com/get-docker/"
		return 1
	fi

	if docker info &>/dev/null; then
		report_ok "Docker" "Docker daemon is running"
		return 0
	else
		report_problem "Docker" "Docker daemon is not running" \
			"Start Docker: sudo systemctl start docker (Linux) or open Docker Desktop (macOS)"
		return 1
	fi
}

# --- Check: Disk Space (>5GB required, >20GB recommended) ---
check_disk_space() {
	local min_space_gb=5
	local recommended_space_gb=20

	# Get available space in the current directory's filesystem (in KB)
	local available_kb=$(df -k . | awk 'NR==2 {print $4}')

	if [[ -z "${available_kb}" ]]; then
		report_warning "Disk Space" "Could not determine available disk space"
		return 1
	fi

	# Convert to GB (integer)
	local available_gb=$((available_kb / 1024 / 1024))

	if [[ "${available_gb}" -lt "${min_space_gb}" ]]; then
		report_problem "Disk Space" "Only ${available_gb}GB available (minimum: ${min_space_gb}GB)" \
			"Free up disk space before running the node"
		return 1
	elif [[ "${available_gb}" -lt "${recommended_space_gb}" ]]; then
		report_warning "Disk Space" "${available_gb}GB available (${recommended_space_gb}GB+ recommended)" \
			"Consider freeing up disk space for optimal performance"
		return 1
	else
		report_ok "Disk Space" "${available_gb}GB available (${recommended_space_gb}GB+ recommended)"
		return 0
	fi
}

# --- Check: Node Modules ---
check_node_modules() {
	if [[ -d "node_modules" ]]; then
		local module_count=$(find node_modules -maxdepth 1 -type d | wc -l)
		if [[ "${module_count}" -gt 10 ]]; then
			report_ok "Dependencies" "node_modules present (${module_count} packages)"
			return 0
		else
			report_warning "Dependencies" "node_modules seems incomplete" \
				"Run: bun install"
			return 1
		fi
	else
		report_problem "Dependencies" "node_modules not found" \
			"Run: bun install"
		return 1
	fi
}

# --- Example Check: Identity File ---
check_identity_file() {
	local identity_file=".demos_identity"

	if [[ -f "${identity_file}" ]]; then
		# Check if file is not empty and has reasonable size
		local size=$(wc -c <"${identity_file}")
		if [[ "${size}" -gt 50 ]]; then
			report_ok "Identity" "Identity file exists (${size} bytes)"
			return 0
		else
			report_warning "Identity" "Identity file seems too small (${size} bytes)" \
				"Identity file may be corrupted. Back it up and regenerate if needed."
			return 1
		fi
	else
		report_warning "Identity" "No identity file found (will be created on first run)" \
			"This is normal for first-time setup"
		return 0
	fi
}

# ============================================================================
# Main Check Runner
# ============================================================================

run_all_checks() {
	print_section "🔍 Running Node Doctor Diagnostics"

	echo ""
	echo "  Environment Checks:"
	run_check "Bun Runtime" check_bun_installed
	run_check "Docker" check_docker_running
	run_check "Disk Space" check_disk_space

	echo ""
	echo "  Repository Checks:"
	run_check "Git Origin" check_git_origin
	run_check "Git Branch" check_git_branch

	echo ""
	echo "  Project Checks:"
	run_check "Dependencies" check_node_modules
	run_check "Identity" check_identity_file
}

# ============================================================================
# Final Report
# ============================================================================

print_report() {
	print_section "📋 Diagnostic Report"

	# Summary line
	echo ""
	echo -e "  ${BOLD}Summary:${NC} ${CHECKS_RUN} checks run"
	echo -e "    ${GREEN}✓ Passed:${NC} ${CHECKS_PASSED}"
	echo -e "    ${RED}✗ Failed:${NC} ${CHECKS_FAILED}"
	echo -e "    ${YELLOW}⚠ Warnings:${NC} ${CHECKS_WARNED}"

	# Problems section
	if [[ ${#PROBLEM_MESSAGES[@]} -gt 0 ]]; then
		echo ""
		echo -e "  ${RED}${BOLD}Problems Found:${NC}"
		for msg in "${PROBLEM_MESSAGES[@]}"; do
			echo -e "    ${RED}✗${NC} ${msg}"
		done
	fi

	# Warnings section
	if [[ ${#WARNING_MESSAGES[@]} -gt 0 ]]; then
		echo ""
		echo -e "  ${YELLOW}${BOLD}Warnings:${NC}"
		for msg in "${WARNING_MESSAGES[@]}"; do
			echo -e "    ${YELLOW}⚠${NC} ${msg}"
		done
	fi

	# Hints section
	if [[ ${#HINT_MESSAGES[@]} -gt 0 ]]; then
		echo ""
		echo -e "  ${BLUE}${BOLD}Suggested Fixes:${NC}"
		for msg in "${HINT_MESSAGES[@]}"; do
			echo -e "    ${msg}"
		done
	fi

	# OK section (verbose mode or if no problems)
	if [[ ${#PROBLEM_MESSAGES[@]} -eq 0 ]] && [[ ${#WARNING_MESSAGES[@]} -eq 0 ]]; then
		echo ""
		echo -e "  ${GREEN}${BOLD}All Checks Passed:${NC}"
		for msg in "${OK_MESSAGES[@]}"; do
			echo -e "    ${GREEN}✓${NC} ${msg}"
		done
	fi

	# Final verdict
	echo ""
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
	if [[ ${#PROBLEM_MESSAGES[@]} -eq 0 ]]; then
		echo -e "  ${GREEN}${BOLD}✓ Your node setup looks healthy!${NC}"
	else
		echo -e "  ${RED}${BOLD}✗ Some issues need attention before running the node.${NC}"
	fi
	echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
	echo ""
}

# ============================================================================
# Production checks (--production): a mainnet validator host
# ============================================================================
# One PASS/WARN/FAIL line per item and exit 1 on any FAIL, so the result can
# be pasted as evidence and used as a gate before `docker compose up`.

PROD_FAILS=0
PROD_WARNS=0
PROD_CHECKS=0
ENV_SOURCE="auto"
NODE_ENV_SOURCE=""
# Set when the settings come from `docker compose config`; the genesis check
# reads the node's bind mounts from it.
COMPOSE_CONFIG_JSON=""
declare -A NODE_ENV_VALUES=()
PARAMETER_SHEET="docs/mainnet/parameters.env"
declare -A SHEET_VALUES=()
declare -a SHEET_KEYS=()
declare -a SHEET_ERRORS=()
# A sheet without one of these would let a node pass with any value for it.
SHEET_REQUIRED_KEYS=(
	CONSENSUS_TIME BLOCK_TIMESTAMP_MIN_DELTA BLOCK_TIMESTAMP_TOLERANCE
	NETWORK_FEE RPC_FEE BURN_FEE RPC_FEE_PERCENT
	MIN_VALIDATOR_STAKE ZK_ATTESTATION_POINTS
	PROD DEMOS_REQUIRE_VALIDATORS FORK_SCHEDULE_MISMATCH_POLICY
)

prod_line() { # $1 PASS|WARN|FAIL, $2 item, $3 detail
	PROD_CHECKS=$((PROD_CHECKS + 1))
	printf '%s %s: %s\n' "$1" "$2" "$3"
	case "$1" in
	PASS) ;;
	WARN) PROD_WARNS=$((PROD_WARNS + 1)) ;;
	*) PROD_FAILS=$((PROD_FAILS + 1)) ;;
	esac
}

# The values the node will actually get. Under Docker only what the compose
# file passes reaches the container, so read compose's resolved environment
# for the node service (it already merges .env and any override file); a
# bare-metal node reads the process environment, then .env for the rest.
load_node_env() {
	if [[ "${ENV_SOURCE}" != "env" ]] && [[ -f docker-compose.yml ]] && command -v docker &>/dev/null; then
		local json
		if json=$(docker compose config --format json 2>/dev/null) && command -v python3 &>/dev/null; then
			COMPOSE_CONFIG_JSON="${json}"
			local line
			while IFS= read -r -d '' line; do
				NODE_ENV_VALUES["${line%%=*}"]="${line#*=}"
			done < <(printf '%s' "${json}" | python3 -c '
import json, sys
env = json.load(sys.stdin).get("services", {}).get("node", {}).get("environment") or {}
if isinstance(env, list):
    env = dict(e.split("=", 1) if "=" in e else (e, "") for e in env)
for k, v in env.items():
    sys.stdout.write(k + "=" + ("" if v is None else str(v)) + "\0")
')
			NODE_ENV_SOURCE="docker compose config, service node"
			return 0
		fi
		if [[ "${ENV_SOURCE}" = "compose" ]]; then
			echo "docker compose config failed (or python3 is missing); run from the node checkout" >&2
			return 1
		fi
	elif [[ "${ENV_SOURCE}" = "compose" ]]; then
		# Falling back to .env would check values the container may never get
		echo "--env-from compose needs docker and a docker-compose.yml in the node checkout" >&2
		return 1
	fi
	if [[ -f .env ]]; then
		local key value
		while IFS='=' read -r key value; do
			key="${key#export }"
			[[ "${key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
			# Unquoted values end at " #", as the node's and compose's .env readers have it.
			if [[ "${value}" != [\"\']* ]]; then
				value="${value%%[[:space:]]#*}"
				value="${value%"${value##*[![:space:]]}"}"
			fi
			value="${value%\"}"; value="${value#\"}"; value="${value%\'}"; value="${value#\'}"
			NODE_ENV_VALUES["${key}"]="${value}"
		done < <(grep -E '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' .env | sed -E 's/^[[:space:]]+//')
	fi
	local k
	for k in $(compgen -e); do NODE_ENV_VALUES["${k}"]="${!k}"; done
	NODE_ENV_SOURCE="process environment over .env"
}

node_env() { printf '%s' "${NODE_ENV_VALUES[$1]-}"; }

# The published must-match values (docs/mainnet/parameters.md): KEY=value,
# comment and blank lines. Any other line, a repeated key or a missing
# required key goes to SHEET_ERRORS, since a skipped line is a value the
# doctor would never check.
load_parameter_sheet() {
	[[ -f "${PARAMETER_SHEET}" ]] || return 1
	local line key n=0
	while IFS= read -r line || [[ -n "${line}" ]]; do
		n=$((n + 1))
		[[ "${line}" =~ ^[[:space:]]*(#.*)?$ ]] && continue
		if [[ ! "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
			SHEET_ERRORS+=("line ${n} is not KEY=value: ${line}")
			continue
		fi
		key="${BASH_REMATCH[1]}"
		if [[ -n "${SHEET_VALUES[${key}]+set}" ]]; then
			SHEET_ERRORS+=("line ${n} sets ${key} again")
			continue
		fi
		SHEET_KEYS+=("${key}")
		SHEET_VALUES["${key}"]="${BASH_REMATCH[2]%"${BASH_REMATCH[2]##*[![:space:]]}"}"
		# PROD= would match a node that leaves it unset and runs the default.
		[[ -n "${SHEET_VALUES[${key}]}" ]] || SHEET_ERRORS+=("line ${n} gives ${key} no value")
	done <"${PARAMETER_SHEET}"
	for key in "${SHEET_REQUIRED_KEYS[@]}"; do
		[[ -n "${SHEET_VALUES[${key}]+set}" ]] || SHEET_ERRORS+=("has no ${key}= line")
	done
	[[ ${#SHEET_KEYS[@]} -gt 0 ]]
}

sheet_why() {
	case "$1" in
	PROD) echo "a node without it creates a new identity when the key file is missing" ;;
	DEMOS_REQUIRE_VALIDATORS) echo "without it a node that cannot read the validator set uses every online peer as the committee" ;;
	FORK_SCHEDULE_MISMATCH_POLICY) echo "warn is for devnets and testnets" ;;
	*) echo "every validator must run the same value" ;;
	esac
}

# Exact match: an unset value would fall back to a built-in default that a
# later release may change, and a spelling the node happens to accept today
# (PROD=1) is not what the other validators confirmed.
check_sheet_value() { # $1 key
	local want v
	want="${SHEET_VALUES[$1]}"
	v=$(node_env "$1")
	if [[ "${v}" = "${want}" ]]; then
		prod_line PASS "$1" "${v}"
	elif [[ -z "${v}" ]]; then
		prod_line FAIL "$1" "not set, the sheet says ${want}: copy it from ${PARAMETER_SHEET} ($(sheet_why "$1"))"
	else
		prod_line FAIL "$1" "is '${v}', the sheet says ${want}: $(sheet_why "$1")"
	fi
}

check_parameter_sheet() {
	if ! load_parameter_sheet; then
		prod_line FAIL "parameter sheet" "${PARAMETER_SHEET} is missing or has no KEY=value line: run from a checkout of the release tag"
		return
	fi
	local key error
	for error in "${SHEET_ERRORS[@]}"; do
		prod_line FAIL "parameter sheet" "${PARAMETER_SHEET} ${error}"
	done
	for key in "${SHEET_KEYS[@]}"; do
		case "${key}" in
		EXPECTED_GENESIS_HASH | EXPECTED_GENESIS_BLOCK_HASH) ;; # check_genesis_pin
		*) check_sheet_value "${key}" ;;
		esac
	done
}

# The node uses the host clock as is and never corrects it, so the host's own
# NTP service is what keeps a validator's block timestamps acceptable.
check_clock_sync() {
	local synced
	if command -v timedatectl &>/dev/null; then
		synced=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
		if [[ "${synced}" = "yes" ]]; then
			prod_line PASS "clock sync" "timedatectl NTPSynchronized=yes"
			return
		fi
	fi
	if command -v chronyc &>/dev/null && chronyc tracking 2>/dev/null | grep -qE '^Leap status[[:space:]]*:[[:space:]]*Normal'; then
		prod_line PASS "clock sync" "chronyc tracking: Leap status Normal"
		return
	fi
	if ! command -v timedatectl &>/dev/null && ! command -v chronyc &>/dev/null; then
		prod_line WARN "clock sync" "skipped: neither timedatectl nor chronyc is installed; confirm by hand that the host's NTP service keeps the clock synchronised"
		return
	fi
	prod_line FAIL "clock sync" "no synchronised clock (timedatectl NTPSynchronized=${synced:-unknown}, no chrony in sync): enable one with 'sudo timedatectl set-ntp true' or install chrony"
}

# The node measures its host clock against public NTP servers and, in
# production, refuses to start when they agree it is off by more than the
# block timestamp tolerance. Without outbound UDP 123 it starts but cannot
# measure, so no check guards the host clock but the host's own NTP.
check_ntp_egress() {
	if ! command -v python3 &>/dev/null; then
		prod_line WARN "NTP egress" "skipped: python3 is needed to query pool.ntp.org on UDP 123"
		return
	fi
	local out
	if out=$(python3 - <<'PY' 2>&1
import socket, struct, time
for host in ("pool.ntp.org", "time.google.com"):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(3)
        s.sendto(b"\x1b" + 47 * b"\0", (host, 123))
        data, _ = s.recvfrom(48)
        secs = struct.unpack("!I", data[40:44])[0] - 2208988800
        print(f"{host} answered, offset {secs - time.time():+.1f} s")
        raise SystemExit(0)
    except (OSError, struct.error):
        continue
print("no answer from pool.ntp.org or time.google.com on UDP 123")
raise SystemExit(1)
PY
	); then
		prod_line PASS "NTP egress" "${out}"
	else
		prod_line WARN "NTP egress" "${out}: allow outbound UDP 123 so the node can measure its clock offset"
	fi
}

check_genesis_pin() { # $1 key
	local v want
	v=$(node_env "$1")
	v="${v#0x}"
	want="${SHEET_VALUES[$1]-}"
	want="${want#0x}"
	if [[ ! "${v,,}" =~ ^[0-9a-f]{64}$ ]]; then
		prod_line FAIL "$1" "not a 64-hex hash ('${v}'): set the value published with the mainnet genesis"
	elif [[ -n "${want}" && "${v,,}" != "${want,,}" ]]; then
		prod_line FAIL "$1" "is ${v}, the sheet says ${want}: this node would join another genesis"
	else
		prod_line PASS "$1" "set"
	fi
}

# Switches meant for one start (recovery, takeover, a rehearsal) that must not
# stay in the environment: left set, each one weakens a safety check on every
# later restart.
check_unset() { # $1 key, $2 why
	local v
	v=$(node_env "$1")
	if [[ -z "${v}" ]] || [[ "${v}" = "false" ]] || [[ "${v}" = "0" ]]; then
		prod_line PASS "$1" "unset"
	else
		prod_line FAIL "$1" "is set ('${v}'): $2"
	fi
}

# Bun also loads these over .env, and the doctor reads only .env, so a value
# in one of them would reach the node unchecked. The image leaves them out.
BUN_EXTRA_ENV_FILES=(
	.env.local
	.env.production .env.production.local
	.env.development .env.development.local
	.env.test .env.test.local
)
check_extra_env_files() {
	local f found=()
	for f in "${BUN_EXTRA_ENV_FILES[@]}"; do
		[[ -e "${f}" ]] && found+=("${f}")
	done
	if [[ ${#found[@]} -eq 0 ]]; then
		prod_line PASS "env files" "only .env"
	else
		prod_line FAIL "env files" "${found[*]} present: bun loads them over .env, so move their values into .env and remove them"
	fi
}

# The range the node accepts for properties.shardSize, mirrored from
# src/libs/consensus/genesisShardSize.ts (no Bun on a Docker host); a test
# keeps the two equal.
GENESIS_SHARD_SIZE_MIN=3
GENESIS_SHARD_SIZE_MAX=100

# The genesis checks a node only makes at boot, or never: a pinned hash
# accepts a file the node then refuses (shardSize out of range), or one it
# boots on but can never forge a block with (fewer validators than the
# quorum). Reads the host file the node container mounts (compose) or
# DEMOS_GENESIS_FILE (bare metal). Prints LEVEL<TAB>item<TAB>detail lines.
read -r -d '' GENESIS_CHECK_PY <<'PY'
import json, os, re, sys
from urllib.parse import urlsplit

mode, genesis_setting, snapshot_setting, smin, smax = sys.argv[1:6]
smin, smax = int(smin), int(smax)


def out(level, item, detail):
    print(level + "\t" + item + "\t" + detail)


def in_container(p, default):
    return os.path.normpath(os.path.join("/app", p or default))


def host_path(mounts, target):
    # The mount nearest to the path decides what the container reads there
    best = None
    for m in mounts:
        t = (m.get("target") or "").rstrip("/")
        if t and (target == t or target.startswith(t + "/")):
            if best is None or len(t) > len(best[0]):
                best = (t, m)
    if best is None or best[1].get("type") != "bind":
        return None
    return best[1]["source"] + target[len(best[0]):]


PORT_RE = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*:(\d+)(?:[/?#]|$)")


def url_problem(u):
    if u is None:
        return None
    if not isinstance(u, str) or u == "":
        return "must be null or a non-empty string"
    m = PORT_RE.match(u)
    if m and not 1 <= int(m.group(1)) <= 65535:
        return "port " + m.group(1) + " is outside 1-65535"
    try:
        parts = urlsplit(u)
        parts.port
    except ValueError:
        return "is not a valid URL"
    # urlsplit takes what WHATWG URL parsing (the node's) refuses
    if not parts.scheme or re.search(r"\s", u):
        return "is not a valid URL"
    if parts.scheme not in ("http", "https"):
        return "is not an http or https URL"
    if not parts.hostname:
        return "has no host"
    return None


def main():
    if mode == "compose":
        mounts = json.load(sys.stdin).get("services", {}).get("node", {}).get("volumes") or []
        target = in_container(genesis_setting, "data/genesis.json")
        genesis_file = host_path(mounts, target)
        if genesis_file is None:
            out("FAIL", "genesis file", target + " in the node container is not mounted from the host, so the node "
                "reads the genesis bundled in the image (the testnet's): mount the published file read-only "
                "(INSTALL.md, \"Pin the network's genesis\")")
            return
        snapshot_dir = host_path(mounts, in_container(snapshot_setting, "data/snapshot"))
    else:
        if not genesis_setting:
            out("FAIL", "genesis file", "DEMOS_GENESIS_FILE is not set, so the node reads data/genesis.json from the "
                "checkout (the testnet's): point it at the published file")
            return
        genesis_file = genesis_setting
        snapshot_dir = snapshot_setting or "data/snapshot"

    if os.path.isdir(genesis_file):
        out("FAIL", "genesis file", genesis_file + " is a directory, not the published file (Docker creates a "
            "directory when the file it should mount does not exist)")
        return
    try:
        with open(genesis_file, encoding="utf-8") as f:
            genesis = json.load(f)
        if isinstance(genesis, str):
            genesis = json.loads(genesis)
    except (OSError, ValueError) as e:
        out("FAIL", "genesis file", genesis_file + " cannot be read as JSON: " + str(e))
        return
    if not isinstance(genesis, dict):
        out("FAIL", "genesis file", genesis_file + " does not hold a JSON object")
        return
    out("PASS", "genesis file", genesis_file)

    props = genesis.get("properties")
    shard = props.get("shardSize") if isinstance(props, dict) else None
    if isinstance(shard, float) and shard.is_integer():
        shard = int(shard)
    if not isinstance(shard, int) or isinstance(shard, bool):
        out("FAIL", "genesis shardSize", "properties.shardSize is " + json.dumps(shard) +
            ", not an integer: the node refuses this genesis at boot")
        shard = None
    elif not smin <= shard <= smax:
        out("FAIL", "genesis shardSize", "properties.shardSize is %d, outside the [%d, %d] the node accepts: "
            "it refuses this genesis at boot" % (shard, smin, smax))
        shard = None
    else:
        out("PASS", "genesis shardSize", str(shard))

    validators = genesis.get("validators")
    validators = validators if isinstance(validators, list) else []
    count, source = len(validators), "the genesis validators"
    manifest_file = os.path.join(snapshot_dir, "manifest.json") if snapshot_dir else None
    if manifest_file and os.path.isfile(manifest_file):
        try:
            with open(manifest_file, encoding="utf-8") as f:
                entry = (json.load(f).get("files") or {}).get("validators.jsonl")
            # The node seeds the validator set from the snapshot when it carries one
            if isinstance(entry, dict) and isinstance(entry.get("rows"), int):
                count, source = entry["rows"], "the snapshot's validators.jsonl"
        except (OSError, ValueError, AttributeError):
            pass
    if shard is not None:
        quorum = shard * 2 // 3 + 1
        if count < quorum:
            out("FAIL", "genesis validators", "%d in %s, below the quorum of %d (2/3 + 1 of shardSize %d): "
                "the node boots but no block after block 0 can be forged" % (count, source, quorum, shard))
        else:
            out("PASS", "genesis validators", "%d in %s, quorum %d" % (count, source, quorum))

    bad = 0
    for i, v in enumerate(validators):
        if not isinstance(v, dict):
            continue
        problem = url_problem(v.get("connection_url", ""))
        if problem:
            bad += 1
            out("FAIL", "genesis connection_url", "validators[%d] (%s) %s %s" % (
                i, v.get("address"), json.dumps(v.get("connection_url")), problem))
    if bad == 0:
        out("PASS", "genesis connection_url", "%d validators" % len(validators))


try:
    main()
except Exception as e:  # one FAIL line instead of a traceback the caller cannot parse
    out("FAIL", "genesis file", "the check failed: %s: %s" % (type(e).__name__, e))
PY

check_genesis_file() {
	if ! command -v python3 &>/dev/null; then
		prod_line WARN "genesis file" "skipped: python3 is needed to read the genesis file"
		return
	fi
	local mode=env level item detail
	[[ -n "${COMPOSE_CONFIG_JSON}" ]] && mode=compose
	while IFS=$'\t' read -r level item detail; do
		prod_line "${level}" "${item}" "${detail}"
	done < <(python3 -c "${GENESIS_CHECK_PY}" "${mode}" \
		"$(node_env DEMOS_GENESIS_FILE)" "$(node_env DEMOS_SNAPSHOT_DIR)" \
		"${GENESIS_SHARD_SIZE_MIN}" "${GENESIS_SHARD_SIZE_MAX}" <<<"${COMPOSE_CONFIG_JSON}")
}

run_production_checks() {
	load_node_env || return 1
	echo "Mainnet validator host checks (node settings from ${NODE_ENV_SOURCE}, parameter sheet ${PARAMETER_SHEET}):"
	check_parameter_sheet
	[[ "${NODE_ENV_SOURCE}" = "process environment over .env" ]] && check_extra_env_files
	check_clock_sync
	check_ntp_egress
	check_genesis_pin EXPECTED_GENESIS_HASH
	check_genesis_pin EXPECTED_GENESIS_BLOCK_HASH
	check_genesis_file
	check_unset DEMOS_ALLOW_UNPINNED_GENESIS "mainnet validators always pin the genesis"
	check_unset DEMOS_DISABLE_FORK_MACHINERY "rehearsal-only, it ignores the genesis fork schedule"
	check_unset DEMOS_IDENTITY_TAKEOVER "set it for the one takeover start only (docs/runbooks/validator-key.md)"
	check_unset DEMOS_GENERATE_IDENTITY "keys are generated off-host"
	check_unset DEMOS_SIGNING_RECORD_REBIND "set it for the one rebind start only (docs/runbooks/validator-key.md)"
	check_unset DEMOS_ACCEPT_FORK_SCHEDULE_DIGEST "set it for the one start that accepts an agreed schedule change only"
	if [[ ${PROD_FAILS} -eq 0 ]]; then
		echo "PASS all ${PROD_CHECKS} checks (${PROD_WARNS} warnings)"
	else
		echo "FAIL ${PROD_FAILS} of ${PROD_CHECKS} checks"
	fi
	[[ ${PROD_FAILS} -eq 0 ]]
}

# ============================================================================
# Help
# ============================================================================

show_help() {
	cat <<EOF
🩺 Node Doctor - Demos Network Diagnostic Tool

USAGE:
    ./node-doctor [OPTIONS]

OPTIONS:
    -h, --help      Show this help message
    -v, --verbose   Show all check results (including passed)
    -q, --quiet     Only show problems (no progress output)
    --production    Mainnet validator host checks only: every value in the
                    mainnet parameter sheet (PROD, DEMOS_REQUIRE_VALIDATORS,
                    mismatch policy, block timing, fees, stake floor, ZK points),
                    clock sync, outbound NTP, genesis pins, the genesis file the
                    node reads (shardSize range, validators against the quorum,
                    validator URLs), and one-start switches left set; one
                    PASS/WARN/FAIL line each, exit 1 on any FAIL
    --parameters FILE
                    With --production: the parameter sheet to compare with
                    (default: docs/mainnet/parameters.env in this checkout)
    --env-from compose|env
                    With --production: where the node's settings are read from
                    (default: docker compose config when docker-compose.yml is here,
                    else the process environment over .env)

DESCRIPTION:
    Node Doctor runs a series of health checks on your Demos Network node
    setup and provides actionable hints when problems are detected.

    Checks include:
    - Runtime environment (Bun, Docker)
    - Git configuration (origin, branch)
    - Project setup (dependencies, identity)
    - And more...

EXAMPLES:
    ./node-doctor           # Run all checks with standard output
    ./node-doctor --verbose # Show detailed results for all checks
    ./scripts/node-doctor --production   # before starting a mainnet validator

For more information: https://demos.network
EOF
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
	# Parse arguments
	while [[ $# -gt 0 ]]; do
		case $1 in
		-h | --help)
			show_help
			exit 0
			;;
		-v | --verbose)
			VERBOSE=true
			shift
			;;
		-q | --quiet)
			QUIET=true
			shift
			;;
		--production)
			PRODUCTION=true
			shift
			;;
		--parameters)
			if [[ -z "${2-}" ]]; then
				echo "--parameters takes a file"
				exit 2
			fi
			# Resolved now: the production checks run from the checkout root
			if [[ "$2" = /* ]]; then PARAMETER_SHEET="$2"; else PARAMETER_SHEET="${PWD}/$2"; fi
			shift 2
			;;
		--env-from)
			case "${2-}" in
			compose | env) ENV_SOURCE="$2" ;;
			*)
				echo "--env-from takes compose or env"
				exit 2
				;;
			esac
			shift 2
			;;
		*)
			echo "Unknown option: $1"
			echo "Use --help for usage information"
			exit 1
			;;
		esac
	done

	if [[ "${PRODUCTION-}" = true ]]; then
		# The checks read files relative to the checkout, wherever this is called from
		cd "$(dirname "$0")/.." || exit 2
		if run_production_checks; then exit 0; else exit 1; fi
	fi

	echo ""
	echo -e "${BOLD}🩺 Node Doctor - Demos Network Diagnostic Tool${NC}"
	echo ""

	# Run all checks
	run_all_checks

	# Print final report
	print_report

	# Exit with appropriate code
	if [[ ${#PROBLEM_MESSAGES[@]} -gt 0 ]]; then
		exit 1
	else
		exit 0
	fi
}

# Sourcing the file only defines the checks, so tests can call one by itself
if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then
	main "$@"
fi
